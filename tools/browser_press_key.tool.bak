{
      "type": "function",
      "function": {
        "name": "browser_press_key",
        "description": "Press a keyboard key on a browser element.",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Element ID returned by browser_observe."
            },
            "key": {
              "type": "string",
              "description": "Key to press, such as Enter, Escape, Tab, Backspace, ArrowUp, ArrowDown, ArrowLeft, or ArrowRight."
            }
          },
          "required": ["id", "key"],
          "additionalProperties": false
        }
      }
    }
